#!/bin/sh
# Block direct pushes to main and reject buildEnv-incompatible derivations.
# Install: git config core.hooksPath checks

status=0

root=$(git rev-parse --show-toplevel) || exit 1

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "ERROR: Direct pushes to '${remote_ref#refs/heads/}' are blocked." >&2
            echo "Create a feature branch and open a pull request instead." >&2
            status=1
            ;;
    esac
done

python3 "$root/checks/lint-buildenv-paths.py" "$root" || status=1

[ "$status" -eq 0 ] || echo "push rejected" >&2
exit "$status"
